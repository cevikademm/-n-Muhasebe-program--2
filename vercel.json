{
  "buildCommand": "echo 'fikoai-spiele: hazir derlenmis dosyalar (site-dist) yayinlaniyor'",
  "installCommand": "echo skip",
  "outputDirectory": "site-dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/oyunlar",
      "destination": "/oyunlar.html"
    },
    {
      "source": "/app",
      "destination": "/muhasebe-app.html"
    },
    {
      "source": "/giris",
      "destination": "/muhasebe-app.html"
    },
    {
      "source": "/login",
      "destination": "/muhasebe-app.html"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/oyunlar(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    }
  ]
}