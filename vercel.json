{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/app", "destination": "/muhasebe-app.html" },
    { "source": "/giris", "destination": "/muhasebe-app.html" },
    { "source": "/login", "destination": "/muhasebe-app.html" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
